#!/bin/sh
set -eu

MC_IMAGE={{ corpus_backup_mc_image | quote }}
MC_CONFIG_DIR={{ (corpus_backup_config_dir ~ '/mc') | quote }}
MC_MEMORY={{ corpus_backup_mc_memory | quote }}
DOCKER_NETWORK={{ corpus_backup_docker_network | quote }}
SOURCE_BUCKET={{ corpus_backup_source_bucket | quote }}
OFFSITE_BUCKET={{ corpus_backup_offsite_bucket | quote }}
PROBE_OBJECT={{ corpus_backup_probe_object | quote }}
PILOT_LIMIT={{ corpus_backup_pilot_limit | quote }}
HEALTHCHECK_URL={{ corpus_backup_healthcheck_url | quote }}
IMMUTABLE_PATTERNS={{ corpus_backup_immutable_patterns | join('\n') | quote }}
ACKNOWLEDGED_ORPHANS={{ corpus_backup_acknowledged_orphans | join('\n') | quote }}
BACKUP_STARTED=0

run_mc() {
    docker run --rm \
        --network "$DOCKER_NETWORK" \
        --read-only \
        --cap-drop ALL \
        --security-opt no-new-privileges \
        --memory "$MC_MEMORY" \
        --pids-limit 128 \
        --tmpfs /tmp:rw,noexec,nosuid,size=64m \
        --tmpfs /root/.mc:rw,noexec,nosuid,size=1m \
        --volume "$MC_CONFIG_DIR/config.json:/root/.mc/config.json:ro" \
        "$MC_IMAGE" "$@"
}

ping_healthcheck() {
    suffix="${1:-}"
    if [ -n "$HEALTHCHECK_URL" ]; then
        curl --fail --silent --show-error \
            --max-time 10 --retry 2 \
            --output /dev/null "${HEALTHCHECK_URL}${suffix}" || true
    fi
}

finish() {
    status=$?
    trap - EXIT HUP INT TERM

    if [ "$BACKUP_STARTED" -eq 1 ]; then
        if [ "$status" -eq 0 ]; then
            ping_healthcheck ""
        else
            ping_healthcheck "/fail"
        fi
    fi

    exit "$status"
}

check_endpoints() {
    # Les buckets doivent préexister : le job n'a pas autorité pour créer une
    # destination ou choisir implicitement une autre cible.
    run_mc stat "source/$SOURCE_BUCKET" >/dev/null
    run_mc stat "offsite/$OFFSITE_BUCKET" >/dev/null
}

object_sha256() {
    run_mc cat "$1" | sha256sum | cut -c 1-64
}

pilot_backup() {
    pilot_objects="$(
        run_mc --no-color find "source/$SOURCE_BUCKET" --print "{}" |
            LC_ALL=C sort |
            head -n "$PILOT_LIMIT"
    )"

    if [ -z "$pilot_objects" ]; then
        echo "ERREUR : aucun objet source accessible pour le pilote." >&2
        return 1
    fi

    pilot_count="$(printf '%s\n' "$pilot_objects" | sed '/^$/d' | wc -l | tr -d ' ')"

    printf '%s\n' "$pilot_objects" | while IFS= read -r source_object; do
        [ -n "$source_object" ] || continue

        relative_object="${source_object#source/$SOURCE_BUCKET/}"
        if [ "$relative_object" = "$source_object" ]; then
            echo "ERREUR : chemin source inattendu : $source_object" >&2
            exit 1
        fi

        offsite_object="offsite/$OFFSITE_BUCKET/$relative_object"
        source_sha="$(object_sha256 "$source_object")"

        if run_mc stat "$offsite_object" >/dev/null 2>&1; then
            offsite_sha="$(object_sha256 "$offsite_object")"
            if [ "$source_sha" = "$offsite_sha" ]; then
                echo "Pilote déjà conforme : $relative_object"
                continue
            fi
        fi

        run_mc cp "$source_object" "$offsite_object"
        offsite_sha="$(object_sha256 "$offsite_object")"

        if [ "$source_sha" != "$offsite_sha" ]; then
            echo "ERREUR : SHA-256 divergent après copie : $relative_object" >&2
            exit 1
        fi

        echo "Pilote copié et vérifié : $relative_object"
    done

    echo "Pilote vérifié : $pilot_count objet(s) déterministe(s)."
}

# Extrait la clé d'objet d'une ligne `>` de `mc diff`. La ligne porte l'URL
# résolue de la cible, pas l'alias : la clé commence après le nom du bucket.
# Une ligne qu'on ne sait pas découper n'est jamais réputée anodine — le
# garde-fou refuse de conclure sur un format qu'il n'a pas su lire.
orphan_key() {
    orphan_path="${1#*> }"
    orphan_relative="${orphan_path#*/$OFFSITE_BUCKET/}"

    if [ "$orphan_relative" = "$orphan_path" ] || [ -z "$orphan_relative" ]; then
        return 1
    fi

    printf '%s\n' "$orphan_relative"
}

# Motifs `case` séparés par des sauts de ligne : l'appelant a déjà positionné
# IFS et `set -f`.
key_matches() {
    for match_pattern in $2; do
        case "$1" in
            $match_pattern) return 0 ;;
        esac
    done

    return 1
}

# Un objet présent uniquement hors site est normal pour un artefact
# régénérable — export PDF servi puis purgé, extraction remplacée par une
# réingestion : la sauvegarde est un historique, pas une réplication des
# suppressions. Sous un préfixe immuable, la lecture s'inverse : le PDF
# d'origine a disparu de MinIO et seule la copie hors site le porte encore.
# La sauvegarde a fait son travail, la source non — c'est un incident.
classify_orphans() {
    tolerated_orphans=0
    lost_sources=""

    for orphan_line in $1; do
        orphan_object="$(orphan_key "$orphan_line" || true)"

        if [ -z "$orphan_object" ]; then
            echo "ERREUR : ligne de comparaison illisible : $orphan_line" >&2
            return 1
        fi

        if key_matches "$orphan_object" "$ACKNOWLEDGED_ORPHANS"; then
            echo "Disparition source acquittée : $orphan_object"
            continue
        fi

        if key_matches "$orphan_object" "$IMMUTABLE_PATTERNS"; then
            lost_sources="$lost_sources  $orphan_object
"
            continue
        fi

        tolerated_orphans=$((tolerated_orphans + 1))
    done

    echo "Orphelins hors site tolérés : $tolerated_orphans objet(s) régénérable(s)."

    if [ -n "$lost_sources" ]; then
        echo "ERREUR : source immuable disparue de MinIO, encore présente hors site :" >&2
        printf '%s' "$lost_sources" >&2
        echo "Restaurer l'objet depuis la cible, ou l'instruire puis l'acquitter dans corpus_backup_acknowledged_orphans." >&2
        return 1
    fi

    return 0
}

# Les motifs contiennent des `*` et les clés peuvent en contenir : le
# découpage se fait sur les sauts de ligne, expansion des chemins coupée.
check_orphans() {
    orphan_lines="$(printf '%s\n' "$1" | grep -E '^[[:space:]]*>' || true)"
    check_orphans_ifs="$IFS"
    IFS='
'
    set -f

    check_orphans_status=0
    classify_orphans "$orphan_lines" || check_orphans_status=$?

    set +f
    IFS="$check_orphans_ifs"

    return "$check_orphans_status"
}

verify_backup() {
    diff_output="$(run_mc --no-color diff \
        "source/$SOURCE_BUCKET" "offsite/$OFFSITE_BUCKET")"

    if [ -n "$diff_output" ]; then
        printf '%s\n' "$diff_output"
    fi

    # `<` = absent de la cible ; `!` = taille ou date divergente.
    if printf '%s\n' "$diff_output" | grep -Eq '^[[:space:]]*[<!]'; then
        echo "ERREUR : la cible ne couvre pas intégralement la source." >&2
        return 1
    fi

    check_orphans "$diff_output" || return 1

    run_mc du "source/$SOURCE_BUCKET"
    run_mc du "offsite/$OFFSITE_BUCKET"

    if [ -n "$PROBE_OBJECT" ]; then
        source_sha="$(object_sha256 "source/$SOURCE_BUCKET/$PROBE_OBJECT")"
        offsite_sha="$(object_sha256 "offsite/$OFFSITE_BUCKET/$PROBE_OBJECT")"

        if [ "$source_sha" != "$offsite_sha" ]; then
            echo "ERREUR : la sonde restaurée ne possède pas le SHA-256 source." >&2
            return 1
        fi

        echo "Sonde SHA-256 vérifiée : $PROBE_OBJECT"
    else
        echo "ATTENTION : aucune sonde SHA-256 configurée." >&2
    fi
}

trap finish EXIT HUP INT TERM

case "${1:-}" in
    dry-run)
        check_endpoints
        run_mc mirror --dry-run --overwrite --retry --summary \
            "source/$SOURCE_BUCKET" "offsite/$OFFSITE_BUCKET"
        ;;
    pilot)
        check_endpoints
        pilot_backup
        ;;
    run)
        BACKUP_STARTED=1
        ping_healthcheck "/start"
        check_endpoints
        run_mc mirror --overwrite --retry --summary \
            "source/$SOURCE_BUCKET" "offsite/$OFFSITE_BUCKET"
        verify_backup
        ;;
    verify)
        check_endpoints
        verify_backup
        ;;
    *)
        echo "Usage : $0 {dry-run|pilot|run|verify}" >&2
        exit 64
        ;;
esac
