x-logging: &default-logging
  driver: json-file
  options:
    max-size: "20m"
    max-file: "3"

services:
  traefik:
    image: public.ecr.aws/docker/library/traefik:v3.6.8
    container_name: traefik
    restart: unless-stopped
    # Exception assumée à `x-logging` (23/09/2026, docs/decisions.md) : ce flux
    # porte le journal d'accès, seule trace des requêtes du site. À 20m × 3, il
    # ne couvrait qu'environ 36 h — trop court pour remonter une vague de sondes
    # repérée le surlendemain. 50m × 10 donne une dizaine de jours au volume du
    # 23/09. La borne disque reste dure : 500 Mio dans le pire cas, bien moins
    # en pratique car les fichiers tournés sont compressés en gzip.
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "10"
        compress: "true"
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
    networks:
      - proxy
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./acme.json:/acme.json
      - ./dynamic:/dynamic:ro
    command:
      - "--api.dashboard=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network=proxy"
      # Provider file : middlewares partagés (ex: upload-limit) référencés
      # depuis les labels des composes applicatifs via "<nom>@file".
      - "--providers.file.directory=/dynamic"
      - "--providers.file.watch=true"
      # Journal d'accès (ajouté le 02/09/2026) : avant ce flag, aucune requête
      # n'était jamais journalisée nulle part pour api/app/mibeko.fr et
      # python.mibeko.fr — impossible de vérifier a posteriori un pic de trafic
      # ou du scraping. Va sur stdout, donc capté par `x-logging` (rotation déjà
      # en place). Attention : le champ RequestPath inclut la query string, donc
      # les liens à token (vérification email, réinitialisation mot de passe)
      # y apparaissent en clair — accès déjà restreint au tunnel SSH prod_ro.
      - "--accesslog=true"
      - "--accesslog.format=json"
      # En-têtes conservés (ajoutés le 23/09/2026) : derrière Cloudflare,
      # ClientHost ne montre que le relais (162.158.x.x) pour mibeko.fr/www.
      # L'IP du visiteur est dans `request_Cf-Connecting-Ip`, mais n'est fiable
      # que si ClientHost appartient aux plages Cloudflare : sur api/app/python,
      # hors proxy, n'importe quel client peut écrire cet en-tête. Tous les
      # autres en-têtes restent supprimés — Authorization et Cookie en tête.
      # `defaultmode=drop` est déjà le défaut de la v3.6.8 (vérifié le 23/09) ;
      # il est écrit en clair pour ne pas dépendre d'un défaut qu'une montée
      # de version pourrait changer.
      - "--accesslog.fields.headers.defaultmode=drop"
      - "--accesslog.fields.headers.names.Cf-Connecting-Ip=keep"
      - "--accesslog.fields.headers.names.Cf-Ipcountry=keep"
      - "--accesslog.fields.headers.names.User-Agent=keep"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--entrypoints.web.http.redirections.entryPoint.scheme=https"
      # TLS-ALPN-01 → HTTP-01 (CDN Cloudflare, vps_infra#1, docs/decisions.md
      # 2026-09-20) : le défi TLS-ALPN-01 se joue directement sur le port 443
      # de l'origine, une connexion spéciale que Let's Encrypt ouvre lui-même —
      # derrière un proxy qui termine TLS, ce défi n'atteint jamais Traefik et
      # le renouvellement échouerait silencieusement. HTTP-01 traverse
      # Cloudflare tant qu'« Always Use HTTPS » reste désactivé côté
      # Cloudflare (Traefik fait déjà la redirection HTTP→HTTPS ci-dessus).
      # `acme.json` est conservé : les certificats déjà émis restent valides,
      # seul le mode de renouvellement change.
      # - "--certificatesresolvers.myresolver.acme.tlschallenge=true"
      - "--certificatesresolvers.myresolver.acme.httpchallenge=true"
      - "--certificatesresolvers.myresolver.acme.httpchallenge.entrypoint=web"
      # Variable Ansible ici :
      - "--certificatesresolvers.myresolver.acme.email={{ traefik_acme_email }}"
      - "--certificatesresolvers.myresolver.acme.storage=/acme.json"
    labels:
      - "traefik.enable=true"
      # Variable Ansible pour le domaine :
      - "traefik.http.routers.dashboard.rule=Host(`traefik.{{ domain }}`)"
      - "traefik.http.routers.dashboard.service=api@internal"
      - "traefik.http.routers.dashboard.entrypoints=websecure"
      - "traefik.http.routers.dashboard.tls.certresolver=myresolver"
      - "traefik.http.routers.dashboard.middlewares=authtraefik"
      # Variable Ansible pour le mot de passe (hashé) :
      - "traefik.http.middlewares.authtraefik.basicauth.users={{ traefik_dashboard_users | replace('$', '$$') }}"

networks:
  proxy:
    external: true
